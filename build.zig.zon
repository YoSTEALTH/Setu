.{
    .name = .setu,
    // year.month.day (no zero padding: semver)
    .version = "2026.11.9",
    .fingerprint = 0x7deee0e42718577f,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tool/setu_build.py", // the wheel build backend projects copy (their check.sh compares)
        "tool/setu_doc.py", // the docs site builder projects copy (`setu-doc-sync` / `setu-doc-check`)
        "tool/setu_doc_web.zig", // its Wasm module, built by a project's `doc-web` step (`addSetuDocSteps`)
        "tool/check_coverage.py", // the `coverage` step's runner (`addCoverageSteps`), run from the dependency
        "tool/check_profile.py", // the `profile` step's runner (`addProfileSteps`; imports check_coverage.py)
        "tool/check_symbol.py", // the `check-symbols` step's runner (`addSymbolCheck`)
        "doc/setu-guide.md", // the guide projects copy (`setu-guide-sync` / `setu-guide-check`)
        "llms.txt",
        "LICENSE.txt",
        "README.md",
    },
}
