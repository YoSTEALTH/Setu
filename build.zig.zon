.{
    .name = .setu,
    // year.month.day (no zero padding: semver)
    .version = "2026.10.26-2",
    .fingerprint = 0x7deee0e42718577f,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools/setu_build.py", // the wheel build backend projects copy (their check.sh compares)
        "tools/setu_docs.py", // the docs site builder projects copy (`setu-docs-sync` / `setu-docs-check`)
        "tools/setu_docs_web.zig", // its Wasm module, built by a project's `docs-web` step (`addSetuDocsSteps`)
        "docs/setu-guide.md", // the guide projects copy (`setu-guide-sync` / `setu-guide-check`)
        "llms.txt",
        "LICENSE.txt",
        "README.md",
    },
}
